{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sonodex",
  "version": "0.0.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "sonodex",
        "width": 1500,
        "height": 900,
        "minWidth": 965,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/*"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBMTc5MkRENDZERDk4QkEKUldTNm1OMUczWklYT3F1Y0lTZDQ0M0JCRDEwK3Jib0tmd3d6WWhaUG5UUkFha3pDb1hhanV5dHQK",
			"endpoints": [
				"https://github.com/PsychicSnailStudios/sonodex-dev/releases/latest/download/latest.json"
			]
		},
    "deep-link": {
      "mobile": [],
      "desktop": {
          "schemes": ["sonodex"]
      }
    }
	}
}